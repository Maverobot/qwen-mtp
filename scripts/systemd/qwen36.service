[Unit]
Description=Qwen3.6-27B MTP llama-server (RTX 4090, parallel=2)
After=network-online.target qwen38.service
Conflicts=qwen36-multi.service qwen38.service

[Service]
Type=simple
EnvironmentFile=%h/.config/qwen-mtp/env
Environment=CUDA_VISIBLE_DEVICES=0
Environment=GGML_CUDA_ENABLE_UNIFIED_MEMORY=0
ExecStart=%h/Dev/qwen-mtp/scripts/run.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
